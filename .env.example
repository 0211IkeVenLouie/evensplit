# Postgres. Fly.io and Railway inject this for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evensplit
PORT=3000

# Public origin, shown on the "share this group" panel.
BASE_URL=http://localhost:3000

# Set to false to skip creating the one-click demo group on boot.
SEED_DEMO=true
# Postgres schema to keep this app's tables in. Leave unset for `public`.
# Set it when several apps share one database (Render's free tier allows only
# one), so their tables and migration history stay separate.
DB_SCHEMA=evensplit
